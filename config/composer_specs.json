            "url": "https://eonet.gsfc.nasa.gov/api/v3/events?status=all&days=7&category=severeStorms",
            "org": "NASA-EONET",
            "extract": "events",
            "provenance": "NASA EONET v3 severe-storm count. NOT food-specific: EONET's drought category is permanently empty, so this stands in as a crop-disruption proxy shared with ENERGY. Replace when a real food-event feed is found."
          }
        ]
      },
      "indirect_proxy": {
        "min": 1,
        "freshness_days": 60,
        "sources": [
          {
            "id": "gi_cereal_yield_kg_per_ha",
            "kind": "file",

{
  "_what_this_is": "The 52 beat() names of fast_cycle_runner.py, grouped into 7 phases so that a failure costs one phase instead of a whole cycle. Generated from the beat() calls themselves, not transcribed: see test/test_cycle_phases_cover_every_step.py, which re-parses the runner and fails if this file and the code disagree.",
  "_identity_is_the_index_not_the_name": "body_scan runs TWICE — at index 0 inside A_ORIENT (is this machine healthy enough to start?) and again at index 13 inside E_PROPOSE (what shall we do about the body?). 53 beat() calls carry 52 distinct names. A phase map keyed by name alone could not represent that, so every step here is identified by (name, index).",
  "_requires": "Files that must EXIST and BELONG TO THIS CYCLE before the phase may start. Belonging is not the same as existing: a file from last night exists and is worthless. --from checks both and refuses rather than guessing.",
  "_produces": "Files the phase must leave behind. A phase that raised nothing but produced nothing is PARTIAL, not DONE. This list is what lets the report contradict the steps.",
  "_not_exhaustive": "produces names the load-bearing artifact per step, not every byte written. Dated outputs (daily/<date>_analysis.json, memory/session_<date>.json, news/<date>/) are deliberately absent: their names move, so presence cannot be checked this way.",
  "phases": {
    "A_ORIENT": {
      "purpose": "Wake up, find out what machine and what rules we are inside, and decide what needs redoing.",
      "index_range": [
        "-1",
        "0.7"
      ],
      "steps": [
        {
          "name": "boot",
          "index": "-1"
        },
        {
          "name": "body_scan",
          "index": "0"
        },
        {
          "name": "canon_load",
          "index": "0.05"
        },
        {
          "name": "telegram_approvals",
          "index": "0.1"
        },
        {
          "name": "brain_briefing",
          "index": "0.2"
        },
        {
          "name": "notify_patches_and_initiatives",
          "index": "0.25"
        },
        {
          "name": "dependency_check",
          "index": "0.5"
        },
        {
          "name": "needs_reanalysis_scan",
          "index": "0.7"
        }
      ],
      "requires": [],
      "produces": [
        "snapshots/body/body_snapshot_latest.json",
        "memory/active_canon_frame.txt",
        "memory/brain_stance.json",
        "memory/brain_cycle_plan.json",
        "snapshots/master/dependency_check_latest.json",
        "snapshots/master/needs_reanalysis_latest.json"
      ]
    },
    "B_SENSE": {
      "purpose": "Reach the outside world. Everything downstream is an opinion about what this phase fetched.",
      "index_range": [
        "1",
        "4"
      ],
      "steps": [
        {
          "name": "web_intelligence",
          "index": "1"
        },
        {

#!/bin/sh
# CORTEX++ control gate (C-CONTROL-1). Every pushed commit must have passed the gate. Fail-closed.
r="$(git rev-parse --show-toplevel)"
g="$r/control/gate.py"; p="$r/venv/Scripts/python.exe"
[ -f "$p" ] || p="$r/venv/bin/python"
if [ ! -f "$g" ] || [ ! -f "$p" ]; then echo "CONTROL GATE MISSING - push blocked (fail-closed)" >&2; exit 1; fi
exec "$p" "$g" pre-push "$@"

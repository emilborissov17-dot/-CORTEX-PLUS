# Normalize line endings. Repo stores text as LF; checkout adapts per-file below.
* text=auto

# Code and data: LF everywhere (portable; stops the LF->CRLF staging warning on Windows).
*.py   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
# Sealed append-only logs beside Institution 0 rows: the Merkle seal hashes their
# exact bytes, so the working copy must hold the same LF bytes the repo holds.
experiments/institution/forward/*.jsonl text eol=lf

# Windows scripts MUST stay CRLF or they can break.
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.vbs  text eol=crlf
# The control's sealed files (C-CONTROL-1): the seal hashes their exact bytes, so git must never
# convert their line endings. Last, so it overrides *.bat eol=crlf for control/install_protection.bat.
control/** -text

*.pyc
*.pyo
*.pyd
.pytest_cache/
*.bak
*.bak_*
*.backup*
*.save
*.prof
chromadb/
logs/
# The cycle's own stdout/stderr — runtime output, pruned to the last 14 runs.
memory/cycle_logs/
snapshots/self/
snapshots/self_archive/
memory/transcript_cache/

# Bulk third-party datasets — downloaded manually, never committed (licence).
# Same convention as the V-Dem CSV. The README explaining HOW to download it
# must survive, or the instructions vanish with the data.
data/ucdp/*
!data/ucdp/README.md

# experiments/pulse — the CODE is committed, the DATA it generates is not.
# Same convention as memory/: runtime output does not belong in git.
experiments/pulse/stream/
experiments/pulse/self_state.jsonl
experiments/pulse/pulse.lock

# experiments/meadow (KPI #6) — the CODE is committed, the THOUGHT is not.
# The notebook (free, unjudged pages) and committed hypotheses are the system's
# private thought. Only Emil and the model itself read them; git does not.
experiments/meadow/notebook/
experiments/meadow/committed/

# experiments/prophecy (K1a) — the CODE is committed, the sealed predictions are not.
# The hash-chained prediction ledger is runtime data (like the existence ledger).
experiments/prophecy/prophecy_ledger.jsonl
experiments/prophecy/*.jsonl


# Атестационната верига (core/notary.py) — печатите за произход на всеки продукт.
# Локален запис за КОНКРЕТНАТА машина и конкретните цикли, не код. Скъсана верига
# се лови от супервайзора при старт, не от git.
attestation/

# ── МИСЪЛТА НА СИСТЕМАТА ЗА САМАТА СЕБЕ СИ (17 авг 2026) ──────────────────────
# Тези файлове НЕ бяха в git и НЕ бяха в .gitignore. Че никога не са попадали в
# историята беше въпрос на това никой да не е написал `git add memory/` — не на
# правило. Под memory/ стоят 1128 неследени файла, които никое правило не покрива;
# един небрежен `git add memory/` ги качва всичките в ПУБЛИЧНО хранилище, завинаги.
#
# Съдържанието им не е тайна и не е ключ — проверено. То е нещо друго: разказът на
# системата за самата себе си, присъдите ѝ по стъпки, планът ѝ за цикъла. Това е
# локален запис за КОНКРЕТНАТА машина, като attestation/ по-горе, и не е код.
#
# ИЗРИЧНО ИЗБРОЕНИ, БЕЗ ШАБЛОН. `memory/self_*` щеше да хване
# memory/self_profile.json и memory/self_awareness.json, които СА следени — а
# правило, което мълчаливо се разминава със състоянието на git, е по-лошо от
# липсващо правило.
memory/self_narrative_latest.txt
memory/self_reflection_log.jsonl
memory/self_directed_priority.json
memory/brain_journal.jsonl
memory/brain_step_log.jsonl
memory/brain_stance.json
memory/brain_cycle_plan.json
memory/local_brain_test.json

# ── REGENERABLE RUNTIME ARTIFACTS UNDER memory/ (21 Aug 2026) ─────────────────
# These thirteen were TRACKED, and were about to become permanent in a PUBLIC
# repo on the feature/lidaction-guard push. A pre-push audit found no secret in
# them — the reason they go is the rule above: the CODE is committed, the DATA
# it generates is not. Every one is rebuilt by a named producer:
#
#   embeddings_cache.json          core/interval_head.py     (2.0 MB cache)
#   interval_head_curve.json       core/interval_head.py
#   interval_head_runs.jsonl       core/interval_head.py
#   training_log.jsonl             core/training_log.py      (1064 rows)
#   step_callmap.json              scripts/step_callmap.py
#   threshold_proposals.json       scripts/propose_alarm_thresholds.py
#   self_experiments.json          core/self_experiment.py
#   self_mirror_latest.json        core/self_mirror.py
#   self_mirror_log.jsonl          core/self_mirror.py
#   micro_cycle_latest.json        scripts/micro_cycle.py
#   micro_cycle_log.jsonl          scripts/micro_cycle.py
#   micro_cycle_contract_latest.json    scripts/micro_cycle.py
#   micro_cycle_contract_baseline.json  scripts/micro_cycle.py
#
# Two suites read two of these from the repo rather than from tmp_path. Their
# data moved to test/fixtures/ and the tests point there, so the suite no longer
# depends on a file a fresh clone does not have. See test/fixtures/README.md.
#
# EXPLICITLY LISTED, NO PATTERN — same reason as the block above: `memory/micro_cycle_*`
# and `memory/self_*` would silently reach files that ARE tracked.
memory/embeddings_cache.json
memory/interval_head_curve.json
memory/interval_head_runs.jsonl
memory/training_log.jsonl
memory/step_callmap.json
memory/threshold_proposals.json
memory/self_experiments.json
memory/self_mirror_latest.json
memory/self_mirror_log.jsonl
memory/micro_cycle_latest.json
memory/micro_cycle_log.jsonl
memory/micro_cycle_contract_latest.json
memory/micro_cycle_contract_baseline.json

# ── СЛЕДАТА НА ДОВЪРШЕНИТЕ СТЪПКИ (22 авг 2026) ──────────────────────────────
# core/cycle_checkpoint.py пише един ред на довършена стъпка. Това е запис за
# КОНКРЕТНИЯ цикъл на КОНКРЕТНАТА машина — регенерира се всяка нощ и не е код,
# точно като artefacts-ите, които 2050200 спря да следи. Изброени поименно, по
# същата причина като по-горе: шаблон memory/cycle_* щеше да хване и следени файлове.
memory/cycle_resume.jsonl
memory/cycle_resume.json
# Записът на прозореца за модела (core/model_window.py) — същото.
memory/model_window.json
# Студената черупка (scripts/intel_daemon.py) — суровите находки от мрежата.
# Регенерира се на всеки ~6h и расте без таван; локален запис, не код.
memory/intel.db
memory/intel.db-journal
memory/intel.db-wal
# Ledger-ът на хипотезите (core/hypothesis_search.py) — присъди по цикли.
memory/hypotheses.jsonl
# Записите на трите колони (core/three_columns.py) — по едно досие на твърдение.
memory/columns/
# Потокът на цикъла (core/flow_score.py) — по един ред на цикъл.
memory/flow_score.jsonl
# Отложената работа за 8b (core/cycle_profile.py) — изчаква първия дневен цикъл.
memory/deferred_batch.json
# Индексът от вграждания (core/embed_index.py) — mmap-ван, регенерира се от кеша.
memory/embed_index/

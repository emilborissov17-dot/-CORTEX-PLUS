+# ── known-answer canaries (C-GUARD-1 Step 3a) ───────────────────────────────
+# Each family copies a real shape under its own head, so it never feeds a rule and never adds to
+# a real shape's count: k atoms plus one more that shares the first argument of atom 7. The query
+# on that argument has exactly two answers.
+CANARY_SIZES = (150, 300, 390)
+
+
+def _canary_families(sizes=CANARY_SIZES) -> list:
+    fams = []
+    for k in sizes:
+        fams.append({"head": f"canary-obs-{k}", "k": k,
+                     "atom": lambda h, i, p, v: f'({h} "k{i}" "C0" "key" "{p}" "2023" "{v}" "u" "src")',
+                     "extra": ("P107", "v507"),
+                     "query": lambda h: f'({h} "k7" $a $b $p $c $v $d $e)', "want": [("P7", "v7"), ("P107", "v507")]})
+        fams.append({"head": f"canary-sub-{k}", "k": k,
+                     "atom": lambda h, i, p, v: f'({h} "s{i}" "{v}")',
+                     "extra": ("-", "c107"),
+                     "query": lambda h: f'({h} "s7" $v)', "want": [("-", "c7"), ("-", "c107")]})
+    return fams
+
+
+def canary_program(sizes=CANARY_SIZES) -> tuple:
+    atoms, before, after = [], [], []
+    for f in _canary_families(sizes):
+        h = f["head"]
+        if f["head"].startswith("canary-obs"):
+            atoms += [f["atom"](h, i, f"P{i}", f"v{i}") for i in range(f["k"])]
+        else:
+            atoms += [f["atom"](h, i, "-", f"c{i}") for i in range(f["k"])]
+        atoms.append(f["atom"](h, 7, *f["extra"]))
+        for phase, out in (("before", before), ("after", after)):
+            pv = "$p" if h.startswith("canary-obs") else '"-"'
+            out.append(f'!(match &self {f["query"](h)} (canary-hit "{h}" "{phase}" {pv} $v))')
+    return "\n".join(atoms), "\n".join(before), "\n".join(after)
+
+
+def expected_canary_hits(sizes=CANARY_SIZES) -> list:
+    return [f'(canary-hit "{f["head"]}" "{phase}" "{p}" "{v}")'
+            for f in _canary_families(sizes) for phase in ("before", "after") for p, v in f["want"]]
+
+
+def check_canaries(raw: list, sizes=CANARY_SIZES) -> dict:
+    """{family: problem} for every family whose answers differ from the known ones, in either phase."""
+    got: dict = {}
+    for e in raw:
+        if e.startswith("(canary-hit"):
+            x = parse(e)
+            got.setdefault((x[1], x[2]), []).append((str(x[3]), str(x[4])))
+    bad = {}
+    for f in _canary_families(sizes):
+        want = sorted(f["want"])
+        for phase in ("before", "after"):
+            have = sorted(got.get((f["head"], phase), []))
+            if have != want:
+                bad[f"{f['head']} {phase}"] = f"got {have}, want {want}"
+    return bad
+
+
+# ── the probes (C-GUARD-1 Step 3b): the defect itself, in its own process ───
+_PROBE = (
+    "import sys\n"
+    "from hyperon import MeTTa\n"
+    "k = int(sys.argv[1]); m = MeTTa(); s = m.space()\n"
+    "for i in range(k):\n"
+    "    s.add_atom(m.parse_single('(obs k%d P%d y2023 v%d)' % (i, i, i)))\n"
+    "s.add_atom(m.parse_single('(obs k7 P107 y2023 v507)'))\n"
+    "print(sorted(str(a) for a in m.run('!(match &self (obs k7 $p y2023 $v) (hit $p $v))')[0]))\n")
+
+
+def probe_verdict(returncode, stdout: str) -> str:
+    if returncode != 0:
+        return "PANIC"
+    return "CORRECT" if stdout.strip() == "['(hit P107 v507)', '(hit P7 v7)']" else "WRONG"
+
+
+def run_probe(k: int, timeout: int = 60) -> str:
+    try:
+        p = subprocess.run([str(SIDECAR_PY), "-c", _PROBE, str(k)], capture_output=True, text=True,
+                           encoding="utf-8", errors="replace", timeout=timeout)
+    except subprocess.TimeoutExpired:
+        return "TIMEOUT"
+    return probe_verdict(p.returncode, p.stdout.strip().splitlines()[-1] if p.stdout.strip() else "")
+
+
+def hyperon_version() -> str:
+    found = sorted((REPO / "venv312_metta" / "Lib" / "site-packages").glob("hyperon-*.dist-info"))
+    return found[-1].name[len("hyperon-"):-len(".dist-info")] if found else "unknown"
+
+
+def _probes(d: Path, sizes, probe: Optional[Callable]) -> dict:
+    ver = hyperon_version()
+    for row in reversed(_jsonl(d / "guard_log.jsonl")):
+        if row.get("probe"):
+            if row["probe"].get("hyperon") == ver:
+                return {**row["probe"], "read_from": row.get("ts")}
+            break
+    res = {str(k): (probe or run_probe)(k) for k in sizes}
+    vals = set(res.values())
+    outcome = ("PROBE_DEFECT_PRESENT" if vals & {"PANIC", "WRONG"} else
+               "PROBE_DEFECT_ABSENT" if vals == {"CORRECT"} else "PROBE_INCONCLUSIVE")
+    return {"hyperon": ver, "results": res, "outcome": outcome}
+
